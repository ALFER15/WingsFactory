<!--
  FAQ VARIANT 3 — Tarjetas numeradas
  =====================================
  Estilo: Grid de tarjetas con numero grande, pregunta y respuesta.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .card h3         → Texto de cada pregunta (x6)                │
  │ .card p          → Texto de cada respuesta (x6)               │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="faq-three">
  <div class="header">
    <p class="eyebrow">Lorem Ipsum</p>
    <h2>Sed do eiusmod tempor incididunt</h2>
  </div>

  <div class="grid">
    <div class="card">
      <span class="num">01</span>
      <h3>Lorem ipsum dolor sit amet?</h3>
      <p>Consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim.</p>
    </div>
    <div class="card">
      <span class="num">02</span>
      <h3>Ut enim ad minim veniam?</h3>
      <p>Quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute irure.</p>
    </div>
    <div class="card">
      <span class="num">03</span>
      <h3>Duis aute irure dolor?</h3>
      <p>In reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat.</p>
    </div>
    <div class="card">
      <span class="num">04</span>
      <h3>Excepteur sint occaecat?</h3>
      <p>Cupidatat non proident sunt in culpa qui officia deserunt mollit anim id est laborum sed ut perspiciatis.</p>
    </div>
    <div class="card">
      <span class="num">05</span>
      <h3>Nemo enim ipsam voluptatem?</h3>
      <p>Quia voluptas sit aspernatur aut odit aut fugit sed quia consequuntur magni dolores eos qui ratione.</p>
    </div>
    <div class="card">
      <span class="num">06</span>
      <h3>Neque porro quisquam est?</h3>
      <p>Qui dolorem ipsum quia dolor sit amet consectetur adipisci velit sed quia non numquam eius modi tempora.</p>
    </div>
  </div>
</section>

<style>
  .faq-three {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem);
    background: linear-gradient(180deg, #0a0a0f 0%, #1a1a2e 100%);
    color: #e2e8f0;
  }

  .header {
    max-width: 680px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fb923c;
  }

  h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(251, 146, 60, 0.15);
    border-radius: 16px;
    padding: 1.4rem;
    transition: border-color 0.2s ease;
  }

  .card:hover {
    border-color: rgba(251, 146, 60, 0.4);
  }

  .num {
    display: inline-block;
    font-size: 1.8rem;
    font-weight: 800;
    color: rgba(251, 146, 60, 0.25);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.3;
  }

  .card p {
    margin: 0;
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
