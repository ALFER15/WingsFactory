<!--
  FAQ VARIANT 4 — Acordeon con iconos laterales
  ================================================
  Estilo: Acordeon con icono de categoria a la izquierda, fondo gradiente.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ details .icon    → Emoji o icono de cada pregunta (x5)        │
  │ summary span     → Texto de cada pregunta (x5)                │
  │ details p        → Texto de cada respuesta (x5)               │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="faq-four">
  <div class="header">
    <p class="eyebrow">Lorem Ipsum</p>
    <h2>Ut labore et dolore magna aliqua</h2>
    <p class="intro">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
  </div>

  <div class="accordion">
    <details>
      <summary>
        <span class="icon">&#9670;</span>
        <span class="text">Lorem ipsum dolor sit amet consectetur?</span>
      </summary>
      <p>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</p>
    </details>
    <details>
      <summary>
        <span class="icon">&#9674;</span>
        <span class="text">Ut enim ad minim veniam quis nostrud?</span>
      </summary>
      <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident.</p>
    </details>
    <details>
      <summary>
        <span class="icon">&#9656;</span>
        <span class="text">Duis aute irure dolor in reprehenderit?</span>
      </summary>
      <p>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde omnis.</p>
    </details>
    <details>
      <summary>
        <span class="icon">&#9650;</span>
        <span class="text">Excepteur sint occaecat cupidatat?</span>
      </summary>
      <p>Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem.</p>
    </details>
    <details>
      <summary>
        <span class="icon">&#9733;</span>
        <span class="text">Sed ut perspiciatis unde omnis iste?</span>
      </summary>
      <p>Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non numquam eius modi tempora incidunt.</p>
    </details>
  </div>
</section>

<style>
  .faq-four {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem);
    background: linear-gradient(180deg, #111827 0%, #0f172a 100%);
    color: #e2e8f0;
  }

  .header {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #f472b6;
  }

  h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .intro {
    margin: 0;
    color: #94a3b8;
  }

  .accordion {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  details {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(244, 114, 182, 0.15);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  details[open] {
    border-color: rgba(244, 114, 182, 0.4);
  }

  summary {
    padding: 1.1rem 1.3rem;
    font-weight: 600;
    font-size: 1rem;
    color: #f1f5f9;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .icon {
    color: #f472b6;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .text {
    flex: 1;
  }

  details p {
    margin: 0;
    padding: 0 1.3rem 1.1rem 3.2rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    summary {
      font-size: 0.92rem;
      padding: 0.9rem 1rem;
      gap: 0.6rem;
    }

    details p {
      padding: 0 1rem 0.9rem 2.6rem;
      font-size: 0.9rem;
    }
  }
</style>
