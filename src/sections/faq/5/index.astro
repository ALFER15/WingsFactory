<!--
  FAQ VARIANT 5 — Dos columnas con CTA lateral
  ================================================
  Estilo: Preguntas a la derecha, titulo y CTA a la izquierda fijo.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ .cta-link        → Texto + href del enlace de contacto       │
  │ details summary  → Texto de cada pregunta (x5)                │
  │ details p        → Texto de cada respuesta (x5)               │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="faq-five">
  <div class="layout">
    <div class="sidebar">
      <p class="eyebrow">Lorem Ipsum</p>
      <h2>Consectetur adipiscing elit</h2>
      <p class="intro">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor.</p>
      <a href="#" class="cta-link">Lorem ipsum dolor &rarr;</a>
    </div>

    <div class="accordion">
      <details open>
        <summary>Lorem ipsum dolor sit amet consectetur?</summary>
        <p>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
      </details>
      <details>
        <summary>Ut enim ad minim veniam quis nostrud?</summary>
        <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat.</p>
      </details>
      <details>
        <summary>Duis aute irure dolor in reprehenderit?</summary>
        <p>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
      </details>
      <details>
        <summary>Excepteur sint occaecat cupidatat?</summary>
        <p>Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores.</p>
      </details>
      <details>
        <summary>Sed ut perspiciatis unde omnis iste?</summary>
        <p>Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit sed quia non numquam.</p>
      </details>
    </div>
  </div>
</section>

<style>
  .faq-five {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem);
    background: linear-gradient(180deg, #0a0a0f 0%, #111827 100%);
    color: #e2e8f0;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 2rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #34d399;
  }

  h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .intro {
    margin: 0 0 1.2rem;
    color: #94a3b8;
    max-width: 35ch;
  }

  .cta-link {
    display: inline-block;
    color: #34d399;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: opacity 0.2s ease;
  }

  .cta-link:hover {
    opacity: 0.8;
  }

  .accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  details {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(52, 211, 153, 0.15);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  details[open] {
    border-color: rgba(52, 211, 153, 0.4);
  }

  summary {
    padding: 1.1rem 1.3rem;
    font-weight: 600;
    font-size: 1rem;
    color: #f1f5f9;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-size: 1.3rem;
    color: #34d399;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    margin: 0;
    padding: 0 1.3rem 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  @media (max-width: 768px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      position: static;
    }

    summary {
      font-size: 0.92rem;
      padding: 0.9rem 1rem;
    }

    details p {
      padding: 0 1rem 0.9rem;
      font-size: 0.9rem;
    }
  }
</style>
