<!--
  IDENTIDAD VARIANT 1 — Mision y vision centrada
  =================================================
  Estilo: Bloque centrado con mision, vision y valores en columnas.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .intro           → Parrafo descriptivo de apoyo              │
  │ .pillar h3       → Titulo de cada pilar (x3)                  │
  │ .pillar p        → Descripcion de cada pilar (x3)             │
  │ .pillar .icon    → Emoji o icono de cada pilar (x3)           │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="id-one">
  <div class="header">
    <p class="eyebrow">Lorem Ipsum</p>
    <h2>Dolor sit amet consectetur adipiscing</h2>
    <p class="intro">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
  </div>

  <div class="pillars">
    <div class="pillar">
      <span class="icon">&#9670;</span>
      <h3>Lorem Ipsum</h3>
      <p>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud.</p>
    </div>
    <div class="pillar">
      <span class="icon">&#9733;</span>
      <h3>Dolor Sit Amet</h3>
      <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
    </div>
    <div class="pillar">
      <span class="icon">&#9679;</span>
      <h3>Consectetur Adipiscing</h3>
      <p>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est.</p>
    </div>
  </div>
</section>

<style>
  .id-one {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem);
    background: linear-gradient(180deg, #0f172a 0%, #0a0a0f 100%);
    color: #e2e8f0;
    text-align: center;
  }

  .header {
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #60a5fa;
  }

  h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .intro {
    margin: 0;
    color: #94a3b8;
    max-width: 55ch;
    margin-left: auto;
    margin-right: auto;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .pillar {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pillar:hover {
    transform: translateY(-3px);
    border-color: rgba(96, 165, 250, 0.45);
  }

  .icon {
    display: block;
    font-size: 2rem;
    margin-bottom: 0.8rem;
    color: #60a5fa;
  }

  .pillar h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: #f1f5f9;
  }

  .pillar p {
    margin: 0;
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
