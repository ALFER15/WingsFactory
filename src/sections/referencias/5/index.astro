<!--
  REFERENCIAS VARIANT 5 — Estadisticas + testimonios compactos
  ==============================================================
  Estilo: Barra de estadisticas arriba, testimonios compactos abajo.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .stat strong     → Cifra destacada (x3)                       │
  │ .stat span       → Descripcion de la cifra (x3)               │
  │ .card blockquote → Texto del testimonio (x3)                  │
  │ .card .name      → Nombre de la persona (x3)                  │
  │ .card .role      → Cargo o empresa (x3)                       │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="ref-five">
