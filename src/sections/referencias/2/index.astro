<!--
  REFERENCIAS VARIANT 2 — Carrusel horizontal de testimonios
  =============================================================
  Estilo: Scroll horizontal con tarjetas anchas, fondo degradado azul.

  ELEMENTOS A SUSTITUIR:
  ┌──────────────────────────────────────────────────────────────┐
  │ .eyebrow         → Texto corto de categoria/etiqueta         │
  │ h2               → Titulo principal de la seccion             │
  │ .card blockquote → Texto del testimonio (x4)                  │
  │ .card .name      → Nombre de la persona (x4)                  │
  │ .card .role      → Cargo o empresa (x4)                       │
  │ .card .stars     → Cantidad de estrellas (x4)                  │
  └──────────────────────────────────────────────────────────────┘
-->

<section class="ref-two">
  <div class="header">
