      <p class="name">Amet Consectetur</p>
      <p class="role">Eiusmod Tempor</p>
    </div>
    <div class="card">
      <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      <blockquote>Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium totam rem.</blockquote>
      <p class="name">Adipiscing Elit</p>
      <p class="role">Incididunt Labore</p>
    </div>
  </div>
</section>

<style>
  .ref-two {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: linear-gradient(180deg, #0a0a0f 0%, #1e1b4b 50%, #0a0a0f 100%);
    color: #e2e8f0;
    overflow: hidden;
  }

  .header {
    max-width: 680px;
    margin-bottom: 2rem;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
