    color: #818cf8;
  }

  h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1.1;
    color: #f1f5f9;
  }

  .scroll-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 clamp(1rem, 4vw, 2rem) 1rem;
